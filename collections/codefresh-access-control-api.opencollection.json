{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codefresh REST Access Control API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Access Control",
