{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codefresh REST Access Control Auth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate an API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://g.codefresh.io/api/auth/key",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate an API key"
        },
        {
          "info": {
            "name": "List API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://g.codefresh.io/api/auth/keys"
          },
          "docs": "List API keys"
        }
      ]
    }
  ],
  "bundled": true
}