{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codefresh REST Access Control Features API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account feature flags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://g.codefresh.io/api/features/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get account feature flags"
        }
      ]
    }
  ],
  "bundled": true
}